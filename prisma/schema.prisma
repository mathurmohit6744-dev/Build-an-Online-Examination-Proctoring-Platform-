// Prisma Schema for ExamSecure PostgreSQL Database
// Corresponds to production relational architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  DESCRIPTIVE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  DISQUALIFIED
}

enum ProctoringEventType {
  FULLSCREEN_EXIT
  TAB_SWITCH
  CAMERA_TRACK_LOST
  FACE_NOT_DETECTED
  MULTIPLE_FACES
  AUDIO_SPIKE
  WINDOW_RESIZE
  RIGHT_CLICK_ATTEMPT
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewDecision {
  CLEARED
  FLAGGED
  DISMISSED
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  passwordHash   String
  role           UserRole       @default(STUDENT)
  avatarUrl      String?
  department     String?
  studentId      String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdExams   Exam[]         @relation("TeacherExams")
  createdQuestions Question[]   @relation("TeacherQuestions")
  examAttempts   ExamAttempt[]
  proctoringEvents ProctoringEvent[]
  auditLogs      AuditLog[]

  @@index([role])
}

model Subject {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  description String?
  createdAt   DateTime    @default(now())

  questions   Question[]
  exams       Exam[]
}

model Question {
  id                      String          @id @default(uuid())
  subjectId               String
  subject                 Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic                   String
  questionText            String
  type                    QuestionType
  difficulty              DifficultyLevel @default(MEDIUM)
  marks                   Float           @default(1.0)
  negativeMarks           Float           @default(0.0)
  correctShortAnswer      String?
  sampleDescriptiveAnswer String?
  explanation             String?
  createdById             String
  createdBy               User            @relation("TeacherQuestions", fields: [createdById], references: [id])
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  options                 QuestionOption[]
  examQuestions           ExamQuestion[]
  submittedAnswers        SubmittedAnswer[]

  @@index([subjectId, topic])
  @@index([type])
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
}

model Exam {
  id                    String         @id @default(uuid())
  title                 String
  code                  String         @unique
  description           String?
  subjectId             String
  subject               Subject        @relation(fields: [subjectId], references: [id])
  durationMinutes       Int
  totalMarks            Float
  passPercentage        Float          @default(40.0)
  instructions          String[]
  status                ExamStatus     @default(DRAFT)
  startTime             DateTime
  endTime               DateTime
  maxAttempts           Int            @default(1)
  shuffleQuestions      Boolean        @default(false)
  shuffleOptions        Boolean        @default(false)
  requireCamera         Boolean        @default(true)
  requireMicrophone     Boolean        @default(true)
  preventTabSwitch      Boolean        @default(true)
  preventFullscreenExit Boolean        @default(true)
  maxViolationsAllowed  Int            @default(5)
  createdById           String
  createdBy             User           @relation("TeacherExams", fields: [createdById], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  questions             ExamQuestion[]
  attempts              ExamAttempt[]

  @@index([status, startTime, endTime])
}

model ExamQuestion {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int

  @@unique([examId, questionId])
  @@index([examId, orderIndex])
}

model ExamAttempt {
  id                    String            @id @default(uuid())
  examId                String
  exam                  Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId             String
  student               User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber         Int               @default(1)
  status                AttemptStatus     @default(IN_PROGRESS)
  startedAt             DateTime          @default(now())
  deadlineAt            DateTime
  submittedAt           DateTime?
  totalScore            Float?
  percentage            Float?
  isPassed              Boolean?
  isProvisional         Boolean           @default(false)
  proctoringEventsCount Int               @default(0)

  answers               SubmittedAnswer[]
  proctoringEvents      ProctoringEvent[]

  @@unique([examId, studentId, attemptNumber])
  @@index([status])
}

model SubmittedAnswer {
  id                 String       @id @default(uuid())
  attemptId          String
  attempt            ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId         String
  question           Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds  String[]
  textAnswer         String?
  isMarkedForReview  Boolean      @default(false)
  isAnswered         Boolean      @default(false)
  autoScore          Float?
  manualScore        Float?
  feedback           String?
  isEvaluated        Boolean      @default(false)
  evaluatedById      String?
  evaluatedAt        DateTime?

  @@unique([attemptId, questionId])
}

model ProctoringEvent {
  id             String              @id @default(uuid())
  attemptId      String
  attempt        ExamAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId      String
  student        User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  eventType      ProctoringEventType
  severity       EventSeverity       @default(MEDIUM)
  timestamp      DateTime            @default(now())
  details        String
  snapshotUrl    String?
  reviewed       Boolean             @default(false)
  reviewDecision ReviewDecision?
  reviewNotes    String?
  reviewedById   String?

  @@index([attemptId, eventType])
  @@index([reviewed])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}
